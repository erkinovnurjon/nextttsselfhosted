# NextTTS — production env namunasi. `.env.prod` ga nusxalab to'ldiring.

# ─── Domen ───
DOMAIN=tts.example.uz

# ─── PostgreSQL ───
POSTGRES_USER=nexttts
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=nexttts

# ─── Frontend (Next.js) ───
# Variant A — Docker ichidagi postgres (db servisi):
DATABASE_URL=postgresql://nexttts:CHANGE_ME_STRONG_PASSWORD@db:5432/nexttts
# Variant B — Neon (bulutli): yuqoridagini Neon connection string bilan almashtiring
#   va docker-compose.yml dagi `db` servisini ishlatmasangiz ham bo'ladi.
#   DATABASE_URL=postgresql://...neon.tech/neondb?sslmode=require

# NextAuth v5: AUTH_SECRET (NEXTAUTH_SECRET EMAS). `openssl rand -base64 32` bilan yarating
AUTH_SECRET=CHANGE_ME_RANDOM_SECRET
AUTH_URL=https://tts.example.uz
AUTH_TRUST_HOST=true
# Backend (Docker ichki tarmoq)
TTS_BACKEND_URL=http://api:8000

# ─── Backend (FastAPI TTS+ASR) ───
MMS_DEFAULT_VOICE=base
WHISPER_DEVICE=          # bo'sh = avto (GPU bo'lsa cuda)
HF_TOKEN=               # FeruzaSpeech/gated model uchun (ixtiyoriy)

# ─── To'lov / Balans to'ldirish ───
# Checkout va webhook callback'lar uchun ilovaning tashqi URL'i
APP_URL=https://tts.example.uz

# Payme (Payme Business → kassa sozlamalari)
PAYME_MERCHANT_ID=
PAYME_KEY=                                 # Merchant API kaliti (test/prod alohida)
PAYME_CHECKOUT_URL=https://checkout.paycom.uz   # test: https://checkout.test.paycom.uz
# Payme kabinetida endpoint sifatida ko'rsating: {APP_URL}/api/payments/payme
# Account maydoni nomi: order_id

# Click (SHOP API / Click Merchant)
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=                          # imzo (MD5) tekshirish uchun
CLICK_CHECKOUT_URL=https://my.click.uz/services/pay
# Click kabinetida URL'lar:
#   Prepare:  {APP_URL}/api/payments/click/prepare
#   Complete: {APP_URL}/api/payments/click/complete

# ─── Chatbot (loyiha-yordamchi) ───
# Bo'sh bo'lsa chatbot oddiy FAQ rejimida ishlaydi (aqlli javoblar uchun kalit kerak).
ANTHROPIC_API_KEY=
# Model: standart claude-opus-4-8. Yuqori hajmli/arzon uchun: claude-haiku-4-5
CHATBOT_MODEL=claude-opus-4-8
