# ============================================================
# DATASET — user recordings stay local (small audio)
# Comment out if you want to sync via Git LFS
# ============================================================
dataset/wavs/*.wav
dataset/raw/
# sentences.json — kichik strukturli ma'lumotlar, repo bilan birga turishi mumkin
# (audio yo'llari ko'rinmaydi laptop'da chunki wavs/ excluded)

# ============================================================
# TRAINING — too large for GitHub (use HuggingFace Hub instead)
# ============================================================
# Butun training data (68+ GB) — hech qachon git'ga qo'shilmaydi
tts-server/training/data/
# ISSAI dataset (~9.5 GB tar + extracted)
tts-server/training/data/ISSAI_USC.tar.gz
tts-server/training/data/issai_raw/
tts-server/training/data/processed_wavs/
tts-server/training/data/cv_wavs/
tts-server/training/data/.cache/
tts-server/training/data/metadata.csv
tts-server/training/data/metadata.csv.bak
tts-server/training/data/*.txt

# Fine-tuned model checkpoints (5.6 GB each)
tts-server/training/checkpoints/

# ============================================================
# GENERATED OUTPUTS — synthesized audio not for git
# ============================================================
tts-server/output/

# ============================================================
# Voice references / samples — model'lar HF'dan yuklanadi, sample audio lokal
# (~56 MB; admin compare/samples uchun, deploy'ga shart emas)
# ============================================================
tts-server/voices/
tts-server/voices/*/reference.wav
