# ============================================================
# Node / Next.js
# ============================================================
node_modules/
.next/
out/
build/
dist/
.vercel
.tsbuildinfo
next-env.d.ts

# ============================================================
# Python / venv / cache
# ============================================================
tts-server/.venv/
**/__pycache__/
*.pyc
*.pyo
.pytest_cache/

# ============================================================
# Environment files
# ============================================================
.env
.env.local
.env*.local
.env.prod

# ============================================================
# Prisma local DB
# ============================================================
prisma/dev.db
prisma/dev.db-journal
prisma/migrations/dev.db*

# ============================================================
# Editor / OS / Logs
# ============================================================
.DS_Store
Thumbs.db
*.log
npm-debug.log*
.claude/

# ============================================================
# DATASET — user recordings stay local (small audio)
# Comment out if you want to sync via Git LFS
# ============================================================
dataset/wavs/*.wav
dataset/raw/
# sentences.json — kichik strukturli ma'lumotlar, repo bilan birga turishi mumkin
# (audio yo'llari ko'rinmaydi laptop'da chunki wavs/ excluded)

# ============================================================
# TRAINING — too large for GitHub (use HuggingFace Hub instead)
# ============================================================
# Butun training data (68+ GB) — hech qachon git'ga qo'shilmaydi
tts-server/training/data/
# ISSAI dataset (~9.5 GB tar + extracted)
tts-server/training/data/ISSAI_USC.tar.gz
tts-server/training/data/issai_raw/
tts-server/training/data/processed_wavs/
tts-server/training/data/cv_wavs/
tts-server/training/data/.cache/
tts-server/training/data/metadata.csv
tts-server/training/data/metadata.csv.bak
tts-server/training/data/*.txt

# Fine-tuned model checkpoints (5.6 GB each)
tts-server/training/checkpoints/

# Lokal yuklangan model og'irliklari (NLLB tarjima ~2.4 GB va h.k.) — HF'dan olinadi
tts-server/models/

# ============================================================
# GENERATED OUTPUTS — synthesized audio not for git
# ============================================================
tts-server/output/

# ============================================================
# Voice references / samples — model'lar HF'dan yuklanadi, sample audio lokal
# (~56 MB; admin compare/samples uchun, deploy'ga shart emas)
# ============================================================
tts-server/voices/
tts-server/voices/*/reference.wav

# Dublyaj natijalari (foydalanuvchi videolari + tayyor mp4) — maxfiy va katta
tts-server/dubs/

# HF fine-tune repo (alohida git-repo, deploy'ga shart emas)
tts-server/training/finetune-hf-vits/

# ============================================================
# Qo'shimcha Python muhitlari (F5 / Piper alohida torch versiyalari)
# ============================================================
tts-server/.venv-f5/
tts-server/venv-piper/
tts-server/training/piper1-gpl/

# ============================================================
# Training/diag yugurish artefaktlari va scratch skriptlar
# ============================================================
runs/
tts-server/runs/
tts-server/training/scripts/runs/
scripts/_*.mjs
tts-server/scripts/_*.py

# ============================================================
# Admin compare/test sahifalari va review audio (lokal sinov)
# Jonli ilova FAQAT public/audition/ ni ishlatadi (kabinet ovoz tanlash).
# Qolgan public/*.html va public/**/*.wav = qo'lda review sahifalari —
# localhost:3000/<name>.html da ko'riladi, Docker image'ga shart emas.
# ============================================================
public/_*.wav
public/*.html
public/**/*.wav
public/**/results.json
!public/audition/
!public/audition/**

# TypeScript incremental build cache
tsconfig.tsbuildinfo
